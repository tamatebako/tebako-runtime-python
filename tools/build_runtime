# Build a tebako python runtime package from the pristine CPython source
# published by tamatebako/python (tfs-python-<version>-src.tar.gz,
# sha256-verified against the release SHA256SUMS), with the spec-17
# driver LINKED into the python3 exe (the README's LINKED-driver
# decision). The python analog of tebako-runtime-ruby's
# tools/build_runtime; the orchestration model is its build/lib port.
#
# The phases (the ruby leg's stage order):
#   1. fetch + verify    the tfs-python tarball (SourceFetcher — the
#                        release SHA256SUMS is the trust anchor)
#   2. link unit + tfs   download + verify link-unit-<ver>-<pid>.tar.gz
#                        (release-API digest anchor; LinkUnit) and the
#                        tfs CLI (published .sha256 sidecar; TfsTool),
#                        both off contract.yml's link_unit_release pin
#   3. configure + make  the relocatable CPython (PythonBuild: prefix =
#                        the mount root; Modules/Setup.local pins the
#                        static/disabled extension contract)
#   4. driver link       the fs TU (build/resources/tebako_python_main.c)
#                        replaces Programs/python.o via the Makefile.pre
#                        substitution; $(TEBAKO_LIBS) carries the scoped
#                        driver + tfs + closure (Mlibs)
#   5. env image         the assembled layout tree (stdlib + the selected
#                        site-packages, layout card, preload shim, L1
#                        manifest) packed by `tfs mkimage` (the default
#                        limnifs writer)
#   6. package           runtime-packages/tebako-runtime-<tebako>-<python>-
#                        <triplet>[.exe] + .tfs + sidecars (.sha256 for
#                        the image, .abi, .contract.yaml)
#   7. boot smoke        tools/boot_smoke (a separate entry — CI runs it
#                        as its own step)
#
# Exit codes (named, never silent): 64 usage · 103 configure · 104 build
# · 105 install/assemble · 106 abi probe · 109 version grammar · 112
# platform/link input · 121/122 source fetch (sha mismatch / download)
# · 123 link-unit miss/download · 124 link-unit sha mismatch/incomplete
# · 125 tfs CLI fetch/verify · 131 image assemble/pack · 141/143 boot
# smoke (tools/boot_smoke).
#
# Usage:
#   tools/build_runtime --python 3.13.15 [--output PATH] [--prefix DIR]
#                       [--tebako-version X.Y.Z] [--src-release TAG]
#                       [--src-mirror URL] [--link-unit-release TAG]
#                       [--link-unit-pid PID] [--jobs N]

require "optparse"

REPO_ROOT = File.expand_path("..", __dir__).freeze
$LOAD_PATH.unshift(File.join(REPO_ROOT, "build", "lib"))

require "tebako_python_builder"

options = {
  python: nil,
  output: nil,
  prefix: File.join(REPO_ROOT, ".build"),
  tebako_version: nil,
  src_release: nil,
  src_mirror: nil,
  link_unit_release: nil,
  link_unit_pid: nil,
  jobs: nil
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: tools/build_runtime [options]"
  opts.on("-P", "--python VERSION", "CPython version to build (e.g. 3.13.15), required") { |v| options[:python] = v }
  opts.on("-o", "--output PATH", "Output runtime package path " \
                                 "(default: runtime-packages/tebako-runtime-<tebako>-<python>-<triplet>)") do |v|
    options[:output] = v
  end
  opts.on("-p", "--prefix DIR", "Build prefix holding deps and the build trees (default: #{options[:prefix]})") { |v| options[:prefix] = v }
  opts.on("--tebako-version VERSION", "Runtime package version (default: the VERSION file)") { |v| options[:tebako_version] = v }
  opts.on("--src-release TAG", "tamatebako/python release tag (default: contract.yml's source_release)") do |v|
    options[:src_release] = v
  end
  opts.on("--src-mirror URL", "Base URL override for the source assets (file:// URLs work)") do |v|
    options[:src_mirror] = v
  end
  opts.on("--link-unit-release TAG", "tamatebako/tebako release tag for the link unit + tfs CLI " \
                                     "(default: contract.yml's link_unit_release)") do |v|
    options[:link_unit_release] = v
  end
  opts.on("--link-unit-pid PID", "The product release's platform id for the link-unit asset " \
                                 "(default: the detected host's)") { |v| options[:link_unit_pid] = v }
  opts.on("-j", "--jobs N", Integer, "Build parallelism (default: detected core count)") { |v| options[:jobs] = v }
  opts.on("-h", "--help", "Print this help") do
    puts opts
    exit 0
  end
end
parser.parse!

begin
  if options[:python].nil?
    puts "Missing required option: --python VERSION"
    puts parser
    exit 64
  end

  tebako_version = options[:tebako_version] || File.read(File.join(REPO_ROOT, "VERSION")).strip
  builder = TebakoPythonBuilder::Builder.new(
    repo_root: REPO_ROOT,
    python_version: options[:python],
    tebako_version: tebako_version,
    prefix: options[:prefix],
    output: options[:output],
    jobs: options[:jobs],
    src_release: options[:src_release],
    src_mirror: options[:src_mirror],
    link_unit_release: options[:link_unit_release],
    link_unit_pid: options[:link_unit_pid]
  )
  builder.run
rescue TebakoPythonBuilder::Error => e
  puts "build_runtime failed: #{e.message} [#{e.error_code}]"
  exit(e.error_code)
end
exit(0)
