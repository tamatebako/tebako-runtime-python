# Emit the python version catalog and the release pins from contract.yml —
# the single source of truth for which published CPython versions this
# factory builds, and which tamatebako/python + tamatebako/tebako releases
# the legs consume. Stdlib only. (The ruby factory keeps its version sets
# in .github/matrix.json; TODO.python/02 keeps the python catalog in
# contract.yml next to the pins.)
#
# Usage:
#   scripts/versions                     # the catalog, as a JSON array
#   scripts/versions --filter SPEC       # full | tidy | catalog | "3.12.14,3.13.15"
#   scripts/versions --pin KEY           # a top-level pin's raw value
#                                        # (link_unit_release | source_release |
#                                        #  container_version | contract_version)
#
# Named errors, exit 64 — an unknown set keyword or version is a usage
# error, never a silently empty set.

require "json"
require "yaml"

REPO_ROOT = File.expand_path("..", __dir__).freeze
CONTRACT_YML = File.join(REPO_ROOT, "contract.yml").freeze

def usage_error(message)
  warn "versions: #{message}"
  exit 64
end

def contract
  @contract ||= YAML.load_file(CONTRACT_YML)
end

def catalog
  sets = contract.fetch("python") do
    usage_error "#{CONTRACT_YML} carries no python: catalog (schema: schema/contract.schema.yml)"
  end
  sets.fetch("catalog") do
    usage_error "#{CONTRACT_YML} python: carries no catalog key (schema: schema/contract.schema.yml)"
  end
end

def resolve_filter(spec)
  case spec
  when "full", "tidy", "catalog"
    contract.fetch("python").fetch(spec)
  when nil, ""
    usage_error "empty filter — expected full | tidy | catalog | a comma-separated version list"
  else
    versions = spec.split(",").map(&:strip).reject(&:empty?)
    unknown = versions - catalog
    unless unknown.empty?
      usage_error "unknown python version(s) #{unknown.join(', ')} — " \
                  "the catalog in contract.yml knows: #{catalog.join(', ')}"
    end
    versions
  end
end

def pin(key)
  unless contract.key?(key)
    usage_error "#{CONTRACT_YML} carries no #{key} pin " \
                "(known: link_unit_release, source_release, container_version, contract_version)"
  end
  contract[key]
end

case ARGV.shift
when nil
  puts JSON.generate(catalog)
when "--filter"
  spec = ARGV.shift || usage_error("--filter needs an argument (full | tidy | catalog | versions)")
  puts JSON.generate(resolve_filter(spec))
when "--pin"
  key = ARGV.shift || usage_error("--pin needs a key (link_unit_release | source_release | ...)")
  puts pin(key)
else
  usage_error "unknown arguments: #{ARGV.join(' ')} — see the usage comment in #{__FILE__}"
end
